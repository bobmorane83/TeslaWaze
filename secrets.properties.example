# Copier ce fichier en `secrets.properties` (gitignoré) et renseigner les valeurs.
# NE JAMAIS committer `secrets.properties`.

# Client ID public de l'application Tesla (Fleet API) — non confidentiel
TESLA_CLIENT_ID=

# URI de redirection OAuth (App Link / custom scheme)
TESLA_REDIRECT_URI=com.teslawaze.app://oauth
